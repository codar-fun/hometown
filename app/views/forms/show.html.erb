<% content_for :title, "#{@form.title} — Hometown" %>
<div style="display:grid;place-items:center;min-height:80vh;padding:32px;">
  <div style="width:min(560px,90vw);">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:32px;">
      <div class="brand-mark">H</div>
      <div style="font-size:13px;color:var(--text-2);">Hometown</div>
    </div>

    <div class="card stack" style="gap:20px;">
      <div>
        <div style="font-size:11px;font-weight:600;color:var(--accent);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:8px;">报名表单</div>
        <h1 style="margin:0 0 8px;font-size:22px;font-weight:700;letter-spacing:-0.02em;"><%= @form.title %></h1>
        <% if @form.description.present? %>
          <p style="margin:0;font-size:14px;color:var(--text-2);line-height:1.6;"><%= @form.description %></p>
        <% end %>
      </div>

      <div style="border-top:1px solid var(--border);padding-top:20px;">
        <p style="margin:0 0 16px;font-size:13px;color:var(--text-2);">请先登录，才能提交报名。</p>
        <%= link_to new_identification_path(return_to: request.path), class: "btn btn-primary", style: "width:100%;justify-content:center;" do %>
          登录 / 注册 后报名
        <% end %>
        <p style="margin:12px 0 0;font-size:11px;color:var(--text-3);text-align:center;">首次登录将自动创建账号，整个过程不超过 1 分钟。</p>
      </div>
    </div>
  </div>
</div>
