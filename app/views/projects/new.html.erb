<% content_for :title, "提交项目 — Hometown" %>
<div class="page" style="max-width:760px;">
  <%= link_to projects_path, class: "btn btn-ghost btn-sm", style: "margin-bottom:12px;" do %>
    <%= inline_svg_icon("arrow_left") %> 取消
  <% end %>

  <div class="page-header" style="border-bottom:none;margin-bottom:4px;padding-bottom:0;">
    <div>
      <h1 class="page-title">提交项目</h1>
      <p class="page-subtitle">Hometown Hackathon 2026 · 在截止日期前提交你的作品</p>
    </div>
  </div>

  <div style="padding:12px 16px;background:#DBEAFE;border-radius:8px;margin-bottom:20px;border-left:4px solid #0284C7;">
    <div style="font-size:13px;color:#075985;">
      <strong>提示：</strong>项目创建后将处于草稿状态，你可以随时编辑。准备好后点击"提交项目"按钮正式提交。
    </div>
  </div>

  <%= form_with model: @project, url: projects_path do |f| %>
    <div class="card" style="padding:0;">

      <%# Section 1: Basics %>
      <div style="padding:20px 24px;border-bottom:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <span style="width:22px;height:22px;border-radius:50%;background:var(--text);color:#FFF;display:grid;place-items:center;font-size:11px;font-weight:700;font-family:var(--font-mono);">1</span>
          <h3 style="margin:0;font-size:14px;font-weight:600;">基础信息</h3>
        </div>
        <div class="stack" style="gap:14px;">
          <div>
            <label class="label">项目名称 <span style="color:var(--danger)">*</span></label>
            <%= f.text_field :name, class: "input input-lg", placeholder: "给你的作品起一个好记的名字", maxlength: 40, required: true %>
          </div>
          <div>
            <label class="label">一句话简介 <span style="color:var(--danger)">*</span></label>
            <%= f.text_field :tagline, class: "input", placeholder: "一句话讲清楚你做了什么", maxlength: 80, required: true %>
          </div>
          <% if @hackathons.any? %>
            <div>
              <label class="label">所属黑客松</label>
              <%= f.select :hackathon_id, @hackathons.map { |h| [h.name, h.id] }, { include_blank: "不关联" }, class: "select" %>
            </div>
          <% end %>
          <% if @teams.any? %>
            <div>
              <label class="label">代表团队</label>
              <%= f.select :team_id, @teams.map { |t| [t.name, t.id] }, { include_blank: "个人参赛" }, class: "select" %>
            </div>
          <% end %>
          <div>
            <label class="label">所属赛道 <span style="color:var(--danger)">*</span></label>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">
              <% ["软件赛道","硬件赛道","文创赛道"].each do |track| %>
                <label style="padding:12px 14px;text-align:left;border:1px solid var(--border);background:var(--surface);border-radius:8px;cursor:pointer;display:flex;align-items:center;gap:10px;">
                  <%= f.check_box :track, { multiple: true, style: "accent-color:var(--accent);" }, track, nil %>
                  <span style="font-size:13px;font-weight:500;"><%= track %></span>
                </label>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# Section 2: Details %>
      <div style="padding:20px 24px;border-bottom:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <span style="width:22px;height:22px;border-radius:50%;background:var(--text);color:#FFF;display:grid;place-items:center;font-size:11px;font-weight:700;font-family:var(--font-mono);">2</span>
          <h3 style="margin:0;font-size:14px;font-weight:600;">项目详情</h3>
        </div>
        <div class="stack" style="gap:14px;">
          <div>
            <label class="label">详细描述 <span style="color:var(--danger)">*</span></label>
            <%= f.text_area :description, class: "input textarea", style: "min-height:280px;font-family:var(--font-mono);font-size:13px;", placeholder: "*该模板仅供参考\n\n基本信息\n* 项目名称\n* 项目 Slogan（可选）\n\n解决问题\n* 痛点描述\n* 目标用户/受益群体\n\n解决方案\n* 方案概述\n* 核心功能/模块（3-5个）\n\n团队介绍\n* 成员构成（姓名/角色/负责模块）\n\n演示与展示\n* Demo 链接/原型地址\n* 演示文稿\n* 项目代码仓库\n* 补充材料", required: true %>
          </div>
        </div>
      </div>

      <%# Section 3: Links %>
      <div style="padding:20px 24px;border-bottom:1px solid var(--border);">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <span style="width:22px;height:22px;border-radius:50%;background:var(--text);color:#FFF;display:grid;place-items:center;font-size:11px;font-weight:700;font-family:var(--font-mono);">3</span>
          <h3 style="margin:0;font-size:14px;font-weight:600;">链接 · 演示</h3>
        </div>
        <div class="stack" style="gap:14px;">
          <div>
            <label class="label">PPT/网页链接/产品链接</label>
            <%= f.text_area :demo_url, class: "input textarea", style: "min-height:80px;", placeholder: "PPT 或其他资源的链接、网盘链接，支持多行" %>
          </div>
          <div>
            <label class="label">GitHub / 代码仓库（软件赛道必填）</label>
            <%= f.text_area :github_url, class: "input textarea", style: "min-height:80px;", placeholder: "代码仓库地址或相关链接，支持多行" %>
          </div>
          <div>
            <label class="label">演示视频链接</label>
            <%= f.text_area :video_url, class: "input textarea", style: "min-height:80px;", placeholder: "腾讯会议、B站、腾讯视频或其他视频平台的链接、网盘链接，支持多行" %>
          </div>
        </div>
      </div>

      <%# Footer %>
      <div style="padding:16px 24px;border-top:1px solid var(--border);background:var(--bg-elev);display:flex;justify-content:space-between;align-items:center;">
        <span style="font-size:12px;color:var(--text-3);">填写带 * 号的必填项后可创建草稿项目</span>
        <div style="display:flex;gap:8px;">
          <%= link_to projects_path, class: "btn" do %>取消<% end %>
          <%= f.submit "创建草稿", class: "btn btn-primary" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
