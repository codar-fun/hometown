<% content_for :title, "#{@project.name} — Hometown" %>
<div class="page" style="max-width:900px;">
  <div style="display:flex;gap:8px;margin-bottom:12px;align-items:center;">
    <%= link_to projects_path, class: "btn btn-ghost btn-sm" do %>
      <%= inline_svg_icon("arrow_left") %> 返回项目列表
    <% end %>
    <% if @is_creator %>
      <%= link_to edit_project_path(@project), class: "btn btn-sm" do %>
        <%= inline_svg_icon("edit") %> 编辑
      <% end %>
    <% end %>
  </div>

  <div class="card" style="padding:0;overflow:hidden;margin-bottom:20px;">
    <div style="height:220px;background:<%= @project.cover_color || '#0C0A09' %>;position:relative;overflow:hidden;">
      <%= render "cover_pattern", project: @project %>
      <% if @project.winner.present? %>
        <div style="position:absolute;top:16px;right:16px;">
          <span class="badge badge-success" style="font-size:11px;padding:4px 10px;">🏆 <%= @project.winner %></span>
        </div>
      <% end %>
    </div>
    <div style="padding:24px;">
      <% if @project.track.any? %>
        <div style="display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap;">
          <% @project.track.each do |t| %>
            <span class="badge"><%= t %></span>
          <% end %>
        </div>
      <% end %>
      <h1 style="font-size:28px;font-weight:600;letter-spacing:-0.02em;margin:0 0 8px;"><%= @project.name %></h1>
      <p style="font-size:15px;color:var(--text-2);margin:0 0 20px;line-height:1.5;"><%= @project.tagline %></p>

      <%# Status badge %>
      <div style="margin-bottom:20px;">
        <% status_color = case @project.status
          when "draft" then "gray"
          when "submitted" then "blue"
          when "approved" then "green"
          when "rejected" then "red"
        end %>
        <% status_label = case @project.status
          when "draft" then "草稿"
          when "submitted" then "已提交"
          when "approved" then "已批准"
          when "rejected" then "已拒绝"
        end %>
        <span class="badge badge-<%= status_color %>" style="margin-right:8px;"><%= status_label %></span>
        <% if @project.rejection_reason.present? %>
          <div style="margin-top:8px;padding:8px 12px;background:#FEE2E2;border-left:3px solid #DC2626;border-radius:4px;">
            <div style="font-size:12px;font-weight:500;color:#991B1B;margin-bottom:4px;">拒绝原因</div>
            <div style="font-size:13px;color:#7F1D1D;"><%= @project.rejection_reason %></div>
          </div>
        <% end %>
      </div>

      <%# Action buttons %>
      <div style="display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap;">
        <% if @is_creator && @project.status == "draft" || @project.status == "rejected" %>
          <% if @project.team_id.blank? %>
            <div style="padding:8px 12px;background:#FEE2E2;border-radius:6px;font-size:12px;color:#991B1B;display:flex;align-items:center;gap:8px;">
              ⚠️ 提交项目需要先选择一个团队。<%= link_to "编辑项目", edit_project_path(@project), class: "underline" %>
            </div>
          <% elsif @is_creator && @project.can_submit?(current_user) %>
            <%= button_to submit_project_path(@project), method: :post, class: "btn btn-primary btn-sm" do %>
              提交项目
            <% end %>
          <% end %>
        <% end %>
        <% if logged_in? && current_user&.admin? %>
          <% if @project.can_approve?(current_user) %>
            <%= button_to approve_project_path(@project), method: :post, class: "btn btn-success btn-sm" do %>
              ✓ 批准
            <% end %>
          <% end %>
          <% if @project.can_reject?(current_user) %>
            <button type="button" class="btn btn-danger btn-sm" onclick="showRejectModal()">✕ 拒绝</button>
          <% end %>
        <% end %>
        <% if @is_creator && @project.status == "rejected" %>
          <%= button_to submit_project_path(@project), method: :post, class: "btn btn-sm" do %>
            重新提交
          <% end %>
        <% end %>
      </div>

      <%# Links %>
      <div style="display:flex;gap:8px;margin-bottom:20px;">
        <% if @project.demo_url.present? %>
          <a href="<%= @project.demo_url =~ /\Ahttps?:\/\// ? @project.demo_url : "https://#{@project.demo_url}" %>" target="_blank" class="btn btn-primary btn-sm">
            <%= inline_svg_icon("external") %> 在线 Demo
          </a>
        <% end %>
        <% if @project.github_url.present? %>
          <a href="<%= @project.github_url =~ /\Ahttps?:\/\// ? @project.github_url : "https://#{@project.github_url}" %>" target="_blank" class="btn btn-sm">
            <%= inline_svg_icon("github") %> 代码仓库
          </a>
        <% end %>
        <div style="margin-left:auto;display:flex;gap:8px;align-items:center;">
          <span style="font-size:13px;color:var(--text-3);display:flex;align-items:center;gap:4px;">
            <%= inline_svg_icon("heart") %> <span class="mono"><%= @project.likes_count %></span>
          </span>
          <span style="font-size:13px;color:var(--text-3);display:flex;align-items:center;gap:4px;">
            <%= inline_svg_icon("message") %> <span class="mono"><%= @comments.count %></span>
          </span>
          <% if logged_in? %>
            <%= button_to star_project_path(@project), method: :post, class: "btn btn-sm #{@liked ? '' : 'btn-primary'}" do %>
              <%= inline_svg_icon("heart") %> <%= @liked ? "已点赞" : "点赞" %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;">
    <div class="stack" style="gap:16px;">
      <%# Description %>
      <div class="card">
        <div style="font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:12px;">项目介绍</div>
        <div style="font-size:14px;line-height:1.7;color:var(--text);white-space:pre-wrap;"><%= @project.description %></div>
      </div>

      <%# Comments %>
      <div class="card">
        <div style="font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:16px;">评论 (<%= @comments.count %>)</div>
        <% @comments.each do |c| %>
          <div style="display:flex;gap:12px;margin-bottom:16px;">
            <div class="avatar" style="width:32px;height:32px;font-size:13px;flex-shrink:0;"><%= c.user.name&.first || "?" %></div>
            <div style="flex:1;">
              <div style="font-size:12px;font-weight:500;margin-bottom:4px;"><%= c.user.display_name %> <span style="color:var(--text-3);font-weight:400;"><%= time_ago_in_words(c.created_at) %>前</span></div>
              <div style="font-size:13px;color:var(--text-2);line-height:1.5;"><%= c.body %></div>
            </div>
          </div>
        <% end %>
        <% if logged_in? %>
          <%= form_with url: "#", method: :post, style: "display:flex;gap:8px;margin-top:8px;" do |f| %>
            <%= f.text_field :body, placeholder: "留下你的想法...", class: "input", style: "flex:1;" %>
            <%= f.submit "发送", class: "btn btn-primary btn-sm" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="stack" style="gap:16px;">
      <%# Tech stack %>
      <% if @project.tech.any? %>
        <div class="card">
          <div style="font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:12px;">技术栈</div>
          <div style="display:flex;flex-wrap:wrap;gap:6px;">
            <% @project.tech.each do |t| %>
              <span style="font-size:11px;padding:3px 8px;border-radius:4px;background:var(--bg-elev-2);color:var(--text-2);font-family:var(--font-mono);border:1px solid var(--border);"><%= t %></span>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Seeking %>
      <% if @project.seeking.any? %>
        <div class="card">
          <div style="font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:12px;">寻找合作</div>
          <div class="stack" style="gap:6px;">
            <% @project.seeking.each do |s| %>
              <div style="font-size:12px;padding:6px 10px;background:var(--accent-soft);color:var(--accent);border-radius:6px;font-weight:500;"><%= s %></div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Team %>
      <div class="card">
        <div style="font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:12px;">团队</div>
        <div class="stack" style="gap:10px;">
          <% @project.project_team_members.includes(:user).each do |tm| %>
            <div style="display:flex;align-items:center;gap:10px;">
              <div class="avatar" style="width:32px;height:32px;font-size:13px;"><%= tm.user.name&.first || "?" %></div>
              <div style="flex:1;min-width:0;">
                <div style="font-size:13px;font-weight:500;"><%= tm.user.display_name %></div>
                <% if tm.role_label.present? %>
                  <div style="font-size:11px;color:var(--text-3);"><%= tm.role_label %></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Submitted at %>
      <% if @project.submitted_at.present? %>
        <div style="font-size:12px;color:var(--text-3);text-align:center;">
          提交于 <%= @project.submitted_at.strftime("%Y 年 %-m 月 %-d 日 %H:%M:%S") %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%# Reject Modal %>
<div id="rejectModal" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
  <div style="background:white;border-radius:12px;padding:24px;max-width:500px;width:90%;box-shadow:0 20px 25px -5px rgba(0,0,0,0.1);">
    <h2 style="margin:0 0 12px;font-size:18px;font-weight:600;">拒绝项目</h2>
    <p style="margin:0 0 16px;color:var(--text-2);font-size:14px;">请提供拒绝项目的原因</p>
    <form method="POST" action="<%= reject_project_path(@project) %>" style="display:flex;flex-direction:column;gap:12px;">
      <textarea name="rejection_reason" placeholder="请输入拒绝原因（可选）" style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:6px;font-family:inherit;font-size:14px;min-height:100px;resize:vertical;"></textarea>
      <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button type="button" onclick="hideRejectModal()" class="btn">取消</button>
        <button type="submit" class="btn btn-danger">确认拒绝</button>
      </div>
    </form>
  </div>
</div>

<script>
function showRejectModal() {
  document.getElementById('rejectModal').style.display = 'flex';
}
function hideRejectModal() {
  document.getElementById('rejectModal').style.display = 'none';
}
document.getElementById('rejectModal').addEventListener('click', function(e) {
  if (e.target === this) {
    hideRejectModal();
  }
});
</script>
