<%# Generative SVG cover patterns, mirroring the JSX prototype %>
<% bg = project.cover_color || '#0C0A09' %>
<% dark_colors = %w[#0C0A09 #0EA5E9 #10B981 #A78BFA #60A5FA #F87171 #F472B6 #FB923C #FBBF24] %>
<% ink = dark_colors.include?(bg) ? 'rgba(255,255,255,0.7)' : 'rgba(12,10,9,0.55)' %>
<% pat = project.cover_pattern || 'grid' %>
<% pid = project.id %>

<% case pat %>
<% when 'grid' %>
  <svg width="100%" height="100%" style="position:absolute;inset:0;">
    <defs>
      <pattern id="g-<%= pid %>" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M 20 0 L 0 0 0 20" fill="none" stroke="<%= ink %>" stroke-width="0.5" opacity="0.4"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#g-<%= pid %>)"/>
  </svg>
<% when 'dots' %>
  <svg width="100%" height="100%" style="position:absolute;inset:0;">
    <defs>
      <pattern id="d-<%= pid %>" width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="9" cy="9" r="1.5" fill="<%= ink %>" opacity="0.6"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#d-<%= pid %>)"/>
  </svg>
<% when 'lines' %>
  <svg width="100%" height="100%" style="position:absolute;inset:0;">
    <defs>
      <pattern id="l-<%= pid %>" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
        <line x1="0" y1="0" x2="0" y2="14" stroke="<%= ink %>" stroke-width="1" opacity="0.4"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#l-<%= pid %>)"/>
  </svg>
<% when 'wave', 'waves' %>
  <svg width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="none" style="position:absolute;inset:0;">
    <% [0, 30, 60, 90, 120, 150].each do |y| %>
      <path d="M 0 <%= y+100 %> Q 100 <%= y+70 %> 200 <%= y+100 %> T 400 <%= y+100 %>" fill="none" stroke="<%= ink %>" stroke-width="1.2" opacity="0.5"/>
    <% end %>
  </svg>
<% when 'circles' %>
  <svg width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;">
    <% (0..4).each do |i| %><circle cx="200" cy="100" r="<%= 20 + i*28 %>" fill="none" stroke="<%= ink %>" stroke-width="1" opacity="<%= (0.6 - i*0.1).round(1) %>"/><% end %>
  </svg>
<% when 'leaves' %>
  <svg width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;">
    <% [40,120,200,280,360].each_with_index do |x,i| %>
      <path d="M <%= x %> 200 Q <%= x-18 %> 140 <%= x %> 80 Q <%= x+18 %> 140 <%= x %> 200" fill="<%= ink %>" opacity="<%= (0.4 + (i%2)*0.2).round(1) %>"/>
    <% end %>
  </svg>
<% when 'hex' %>
  <svg width="100%" height="100%" style="position:absolute;inset:0;">
    <defs>
      <pattern id="h-<%= pid %>" width="28" height="32" patternUnits="userSpaceOnUse">
        <polygon points="14,2 26,9 26,23 14,30 2,23 2,9" fill="none" stroke="<%= ink %>" stroke-width="1" opacity="0.5"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#h-<%= pid %>)"/>
  </svg>
<% when 'bars' %>
  <svg width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="none" style="position:absolute;inset:0;">
    <% (0..7).each do |i| %>
      <rect x="<%= i*50 %>" y="<%= 60 + (i%3)*20 %>" width="30" height="<%= 80 - (i%3)*20 %>" fill="<%= ink %>" opacity="<%= (0.3 + (i%3)*0.1).round(1) %>"/>
    <% end %>
  </svg>
<% when 'rings' %>
  <svg width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice" style="position:absolute;inset:0;">
    <% (0..3).each do |i| %>
      <circle cx="<%= 350-i*80 %>" cy="<%= 50+i*40 %>" r="28" fill="none" stroke="<%= ink %>" stroke-width="1.5" opacity="0.55"/>
    <% end %>
  </svg>
<% end %>
