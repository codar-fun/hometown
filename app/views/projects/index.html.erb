<% content_for :title, "项目展示 — Hometown" %>
<div class="page" style="max-width:1200px;">
  <div class="page-header">
    <div>
      <h1 class="page-title">项目展示</h1>
      <p class="page-subtitle"><%= Project.count %> 个项目 · 黑客松提交作品</p>
    </div>
    <div style="display:flex;gap:8px;">
      <% if logged_in? %>
        <%= link_to new_project_path, class: "btn btn-primary" do %>
          <%= inline_svg_icon("plus") %> 提交项目
        <% end %>
      <% else %>
        <%= link_to new_identification_path, class: "btn btn-primary" do %>登录后提交<% end %>
      <% end %>
    </div>
  </div>

  <%# Track filter + sort %>
  <div style="display:flex;gap:8px;margin-bottom:24px;flex-wrap:wrap;align-items:center;">
    <%= link_to projects_path(sort: params[:sort]), class: "btn btn-sm #{params[:track].blank? ? 'btn-primary' : ''}" do %>全部<% end %>
    <% @tracks.each do |track| %>
      <%= link_to projects_path(track: track, sort: params[:sort]), class: "btn btn-sm #{params[:track] == track ? 'btn-primary' : ''}" do %><%= track %><% end %>
    <% end %>
    <div style="margin-left:auto;display:flex;gap:4px;">
      <%= link_to projects_path(track: params[:track], sort: "likes"), class: "btn btn-sm #{params[:sort] == 'likes' ? 'btn-primary' : ''}" do %>最多点赞<% end %>
      <%= link_to projects_path(track: params[:track], sort: "new"), class: "btn btn-sm #{params[:sort] != 'likes' ? 'btn-primary' : ''}" do %>最新<% end %>
    </div>
  </div>

  <%# Project grid %>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;">
    <% @projects.each do |p| %>
      <%= link_to project_path(p), style: "text-decoration:none;" do %>
        <div class="card" style="padding:0;overflow:hidden;transition:box-shadow .15s;" onmouseenter="this.style.boxShadow='var(--shadow-md)'" onmouseleave="this.style.boxShadow=''">
          <%# Cover %>
          <div style="height:140px;background:<%= p.cover_color || '#0C0A09' %>;position:relative;overflow:hidden;">
            <%= render "projects/cover_pattern", project: p %>
            <% if p.winner.present? %>
              <div style="position:absolute;top:12px;right:12px;">
                <span class="badge badge-success" style="font-size:10px;">🏆 <%= p.winner %></span>
              </div>
            <% end %>
          </div>
          <div style="padding:16px;">
            <% if p.track.present? %>
              <span class="badge" style="margin-bottom:8px;font-size:10px;"><%= p.track %></span>
            <% end %>
            <div style="font-size:15px;font-weight:600;margin-bottom:4px;color:var(--text);"><%= p.name %></div>
            <div style="font-size:13px;color:var(--text-2);margin-bottom:12px;line-height:1.4;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;"><%= p.tagline %></div>
            <% if p.seeking.any? %>
              <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:12px;">
                <% p.seeking.first(2).each do |s| %>
                  <span style="font-size:10px;padding:2px 6px;border-radius:3px;background:#ECFCCB;color:var(--accent);font-weight:500;"><%= s %></span>
                <% end %>
              </div>
            <% end %>
            <div style="display:flex;align-items:center;justify-content:space-between;padding-top:12px;border-top:1px solid var(--border);">
              <div style="display:flex;align-items:center;gap:-6px;">
                <% p.project_team_members.first(3).each_with_index do |tm, i| %>
                  <div class="avatar" style="width:22px;height:22px;font-size:9px;margin-left:<%= i == 0 ? 0 : -6 %>px;border:2px solid var(--bg);">
                    <%= tm.user.name&.first || "?" %>
                  </div>
                <% end %>
              </div>
              <div style="display:flex;align-items:center;gap:12px;font-size:12px;color:var(--text-3);">
                <span><%= inline_svg_icon("heart") %> <%= p.likes_count %></span>
                <span><%= inline_svg_icon("message") %> <%= p.project_comments.count %></span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <% if @projects.empty? %>
    <div style="padding:80px;text-align:center;color:var(--text-3);">
      <div style="font-size:32px;margin-bottom:12px;">🚀</div>
      <div style="font-size:16px;font-weight:500;margin-bottom:8px;">还没有项目</div>
      <p style="font-size:13px;margin-bottom:20px;">黑客松结束后，参赛者会在这里提交他们的作品。</p>
      <% if logged_in? %>
        <%= link_to new_project_path, class: "btn btn-primary" do %>提交第一个项目<% end %>
      <% end %>
    </div>
  <% end %>
</div>
