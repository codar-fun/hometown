<% content_for :title, "Hometown — 社区首页" %>
<div class="page" style="max-width:980px;">

  <%# Hero %>
  <div style="margin-bottom:48px;">
    <div style="display:inline-flex;align-items:center;gap:8px;padding:6px 12px;background:var(--accent-soft);border:1px solid rgba(163,230,53,0.25);border-radius:999px;font-size:12px;color:var(--accent);margin-bottom:20px;">
      <span style="width:6px;height:6px;border-radius:50%;background:var(--accent);"></span>
      报名进行中 · 截止 5 月 10 日
    </div>
    <h1 style="font-size:clamp(28px,6vw,44px);font-weight:600;letter-spacing:-0.03em;margin:0 0 12px;line-height:1.1;">
      一个让独立开发者<br>
      <span style="color:var(--text-3);">不再孤单的</span> 社区。
    </h1>
    <p style="font-size:16px;color:var(--text-2);max-width:560px;margin:0 0 28px;line-height:1.6;">
      Hometown 是为热爱手艺的工程师、设计师和产品人准备的小镇广场。我们办黑客松、办读书会、办深夜聊天 — 也帮你找到一起做事的人。
    </p>
    <div style="display:flex;gap:10px;">
      <% featured_hackathon = Hackathon.featured.first %>
      <% if featured_hackathon&.form&.published? %>
        <%= link_to form_path(featured_hackathon.form.slug), class: "btn btn-primary btn-lg" do %>
          报名黑客松
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        <% end %>
      <% end %>
      <%= link_to events_path, class: "btn btn-lg" do %>了解活动<% end %>
    </div>
  </div>

  <%# Feature grid %>
  <div class="grid-2-1">
    <%# Hackathon card %>
    <% hackathon = featured_hackathon %>
    <% if hackathon %>
      <div class="card" style="background:linear-gradient(135deg,#F7FEE7 0%,#FFFFFF 60%);border-color:#D9F99D;padding:28px;position:relative;overflow:hidden;">
        <div style="position:absolute;right:-40px;top:-40px;width:200px;height:200px;background:radial-gradient(circle,rgba(77,124,15,0.10),transparent 70%);border-radius:50%;"></div>
        <div style="position:relative;">
          <div style="font-size:11px;color:var(--accent);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:8px;font-weight:600;">主舞台 · 即将开始</div>
          <div style="font-size:28px;font-weight:600;letter-spacing:-0.02em;margin-bottom:8px;"><%= hackathon.name %></div>
          <div style="font-size:13px;color:var(--text-2);margin-bottom:20px;line-height:1.6;">
            <%= hackathon.tagline %>
          </div>
          <div style="display:flex;gap:24px;font-size:12px;color:var(--text-2);">
            <div>
              <div style="font-size:11px;color:var(--text-3);margin-bottom:2px;">已报名</div>
              <div style="font-size:18px;font-weight:600;font-family:var(--font-mono);"><%= hackathon.registered_count %><span style="color:var(--text-3);font-size:13px;"> / <%= hackathon.capacity %></span></div>
            </div>
            <div>
              <div style="font-size:11px;color:var(--text-3);margin-bottom:2px;">奖池</div>
              <div style="font-size:18px;font-weight:600;font-family:var(--font-mono);">¥<%= number_with_delimiter(hackathon.prize_pool.to_i) %></div>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="card" style="background:linear-gradient(135deg,#F7FEE7 0%,#FFFFFF 60%);border-color:#D9F99D;padding:28px;">
        <div style="font-size:28px;font-weight:600;margin-bottom:8px;">Hometown Hackathon</div>
        <p style="color:var(--text-2);font-size:14px;">敬请期待下一届黑客松报名。</p>
      </div>
    <% end %>

    <%# This week events %>
    <div class="card">
      <div style="font-size:11px;color:var(--text-3);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:12px;font-weight:600;">本周</div>
      <div class="stack" style="gap:12px;">
        <% Event.upcoming.limit(3).each do |ev| %>
          <div style="display:flex;align-items:center;gap:12px;padding-bottom:12px;border-bottom:1px solid var(--border);">
            <div style="font-size:11px;font-family:var(--font-mono);color:var(--text-3);width:80px;flex-shrink:0;"><%= ev.time_label || ev.date&.strftime("%-m/%-d") %></div>
            <div style="flex:1;min-width:0;">
              <div style="font-size:13px;font-weight:500;"><%= ev.title %></div>
              <div style="font-size:11px;color:var(--text-3);"><%= ev.kind %> · <%= ev.going_count %> 人</div>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color:var(--text-3);flex-shrink:0;"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        <% end %>
        <% if Event.upcoming.count == 0 %>
          <p style="color:var(--text-3);font-size:13px;">暂无即将开始的活动</p>
        <% end %>
      </div>
    </div>
  </div>

  <%# Recent members %>
  <div style="margin-bottom:24px;font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;">最近加入的小镇居民</div>
  <div style="display:flex;gap:8px;flex-wrap:wrap;">
    <% User.order(created_at: :desc).limit(10).each_with_index do |u, i| %>
      <%= link_to profile_path(u), style: "display:flex;align-items:center;gap:8px;padding:6px 10px 6px 6px;background:var(--bg-elev);border:1px solid var(--border);border-radius:999px;text-decoration:none;" do %>
        <div class="avatar" style="width:22px;height:22px;font-size:10px;<%= u.avatar_color.present? ? "background:#{u.avatar_color};color:#0C0A09;" : "background:hsl(#{(i*37)%360},50%,60%);" %>">
          <%= u.name&.first || u.email&.first&.upcase || "?" %>
        </div>
        <span style="font-size:12px;color:var(--text);"><%= u.name || u.handle || u.email&.split("@")&.first %></span>
      <% end %>
    <% end %>
  </div>
</div>
