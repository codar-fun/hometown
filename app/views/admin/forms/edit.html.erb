<% content_for :title, "编辑表单 — #{@form.title}" %>

<div style="max-width:760px;">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
    <%= link_to admin_forms_path, class: "btn btn-ghost btn-sm" do %>
      <%= inline_svg_icon("arrow_left") %>
    <% end %>
    <div style="flex:1;">
      <div style="font-size:11px;color:var(--text-3);margin-bottom:2px;">表单管理</div>
      <h1 style="margin:0;font-size:20px;font-weight:600;"><%= @form.title %></h1>
    </div>
    <div style="display:flex;gap:8px;">
      <% if @form.published? %>
        <%= button_to unpublish_admin_form_path(@form), method: :patch, class: "btn btn-sm" do %>下线<% end %>
      <% else %>
        <%= button_to publish_admin_form_path(@form), method: :patch, class: "btn btn-primary btn-sm" do %>发布<% end %>
      <% end %>
    </div>
  </div>

  <%= render "form", form: @form %>
</div>
