<% content_for :title, "表单 — Hometown" %>
<div class="page" style="max-width:1100px;">
  <div class="page-header">
    <div>
      <h1 class="page-title">表单</h1>
      <p class="page-subtitle">管理你的所有表单 — 报名、调研、招募。</p>
    </div>
    <div style="display:flex;gap:8px;align-items:center;">
      <%= form_with url: admin_forms_path, method: :get, style: "position:relative;" do |f| %>
        <span style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--text-3);">
          <%= inline_svg_icon("search") %>
        </span>
        <%= f.text_field :q, value: params[:q], placeholder: "搜索表单...", class: "input", style: "width:220px;padding-left:32px;" %>
      <% end %>
      <%= link_to new_admin_form_path, class: "btn btn-primary" do %>
        <%= inline_svg_icon("plus") %> 新建表单
      <% end %>
    </div>
  </div>

  <%# Status tabs %>
  <div style="display:flex;gap:6px;margin-bottom:20px;border-bottom:1px solid var(--border);">
    <% [
      { id: "all",    label: "全部",   count: @counts[:all] },
      { id: "live",   label: "已发布", count: @counts[:live] },
      { id: "draft",  label: "草稿",   count: @counts[:draft] },
      { id: "closed", label: "已关闭", count: @counts[:closed] },
    ].each do |t| %>
      <% active = params[:status] == t[:id] || (t[:id] == "all" && params[:status].blank?) %>
      <%= link_to admin_forms_path(status: t[:id], q: params[:q]),
            style: "padding:10px 14px;background:transparent;text-decoration:none;color:#{active ? 'var(--text)' : 'var(--text-3)'};font-size:13px;font-weight:500;border-bottom:2px solid;border-color:#{active ? 'var(--accent)' : 'transparent'};margin-bottom:-1px;display:inline-flex;align-items:center;gap:6px;" do %>
        <%= t[:label] %>
        <span style="font-size:11px;color:var(--text-3);padding:0 6px;background:var(--bg-elev-2);border-radius:4px;"><%= t[:count] %></span>
      <% end %>
    <% end %>
  </div>

  <div class="table-wrap">
    <div style="display:grid;grid-template-columns:1fr 110px 100px 130px 130px 40px;padding:10px 16px;border-bottom:1px solid var(--border);font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;background:var(--bg);">
      <div>名称</div>
      <div>状态</div>
      <div style="text-align:right;">响应数</div>
      <div style="text-align:right;">创建时间</div>
      <div style="text-align:right;">更新时间</div>
      <div></div>
    </div>

    <% if @forms.empty? %>
      <div style="padding:40px;text-align:center;color:var(--text-3);font-size:13px;">
        没有符合条件的表单
      </div>
    <% else %>
      <% @forms.each do |form| %>
        <%= link_to edit_admin_form_path(form),
              style: "display:grid;grid-template-columns:1fr 110px 100px 130px 130px 40px;padding:14px 16px;border-bottom:1px solid var(--border);text-decoration:none;color:var(--text);align-items:center;background:transparent;transition:background 0.1s;",
              data: { controller: "hover" },
              onmouseover: "this.style.background='var(--bg-elev)'",
              onmouseout: "this.style.background='transparent'" do %>
          <div>
            <div style="font-size:14px;font-weight:500;margin-bottom:2px;"><%= form.title %></div>
            <div style="font-size:12px;color:var(--text-3);font-family:var(--font-mono);">/<%= form.slug %></div>
          </div>
          <div>
            <% if form.published? %>
              <span class="badge badge-success badge-dot">已发布</span>
            <% else %>
              <span class="badge">草稿</span>
            <% end %>
          </div>
          <div style="text-align:right;font-family:var(--font-mono);font-size:13px;"><%= form.form_submissions.count %></div>
          <div style="text-align:right;color:var(--text-3);font-size:12px;font-family:var(--font-mono);"><%= form.created_at.strftime("%-m/%-d %H:%M") %></div>
          <div style="text-align:right;color:var(--text-3);font-size:12px;font-family:var(--font-mono);"><%= form.updated_at.strftime("%-m/%-d %H:%M") %></div>
          <div style="text-align:right;color:var(--text-3);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
