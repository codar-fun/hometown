<% content_for :title, "申请详情 — Hometown" %>
<%= turbo_frame_tag "detail_panel" do %>
  <%= render "detail", submission: @submission %>
<% end %>

<%# Fallback full-page layout when accessed directly (not via Turbo Frame) %>
<% unless turbo_frame_request? %>
  <div class="page" style="max-width:760px;">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
      <%= link_to admin_form_submissions_path, class: "btn btn-ghost btn-sm" do %>
        <%= inline_svg_icon("arrow_left") %>
      <% end %>
      <div style="flex:1;">
        <div style="font-size:11px;color:var(--text-3);margin-bottom:2px;">报名审核</div>
        <h1 style="margin:0;font-size:20px;font-weight:600;"><%= @submission.user.display_name %></h1>
      </div>
    </div>
  </div>
<% end %>
