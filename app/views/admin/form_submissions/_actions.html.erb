<div class="submission-actions" id="submission_actions_<%= submission.id %>">
  <% if submission.status == "pending" %>
    <%= form_with url: approve_admin_form_form_submission_path(form, submission), method: :patch do |f| %>
      <div class="form-group">
        <%= f.text_area :admin_note, placeholder: "Optional note to applicant...", class: "form-input", rows: 2 %>
      </div>
      <%= f.submit "Approve", class: "btn btn-success" %>
    <% end %>
    <%= form_with url: reject_admin_form_form_submission_path(form, submission), method: :patch do |f| %>
      <div class="form-group">
        <%= f.text_area :admin_note, placeholder: "Optional note to applicant...", class: "form-input", rows: 2 %>
      </div>
      <%= f.submit "Reject", class: "btn btn-danger" %>
    <% end %>
  <% else %>
    <p>Decision made: <strong><%= submission.status.capitalize %></strong></p>
  <% end %>
</div>
