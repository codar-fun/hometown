<% content_for :title, "编辑 #{@hackathon.name} — Hometown" %>
<div class="page" style="max-width:760px;">
  <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">
    <%= link_to admin_hackathons_path, class: "btn btn-ghost btn-sm" do %>
      <%= inline_svg_icon("arrow_left") %>
    <% end %>
    <div style="flex:1;">
      <div style="font-size:11px;color:var(--text-3);margin-bottom:2px;">黑客松 · 编辑</div>
      <h1 style="margin:0;font-size:20px;font-weight:600;"><%= @hackathon.name %></h1>
    </div>
    <div style="display:flex;gap:8px;">
      <%= status_badge(@hackathon.status) %>
      <% if @hackathon.status == "draft" %>
        <%= button_to "发布", publish_admin_hackathon_path(@hackathon), method: :patch, class: "btn btn-primary btn-sm" %>
      <% elsif @hackathon.status == "live" %>
        <%= button_to "下线", unpublish_admin_hackathon_path(@hackathon), method: :patch, class: "btn btn-sm" %>
      <% end %>
      <%= button_to admin_hackathon_path(@hackathon), method: :delete,
            data: { turbo_confirm: "确认删除此黑客松？" }, class: "btn btn-danger btn-sm" do %>
        <%= inline_svg_icon("x") %> 删除
      <% end %>
    </div>
  </div>

  <%= render "form", hackathon: @hackathon %>
</div>
