<% content_for :title, "登录 — Hometown" %>
<div style="display:grid;place-items:center;min-height:80vh;padding:32px;">
  <div style="width:min(420px,90vw);" data-controller="auth-toggle">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:24px;">
      <div class="brand-mark">H</div>
      <div style="font-weight:600;font-size:15px;">登录到 Hometown</div>
    </div>

    <div class="card stack" style="gap:16px;">
      <%# Method toggle segment %>
      <div style="display:flex;background:var(--bg);padding:4px;border-radius:8px;border:1px solid var(--border);">
        <button type="button"
          data-auth-toggle-target="phoneBtn"
          data-action="click->auth-toggle#selectPhone"
          data-active="true"
          style="flex:1;height:32px;border:none;border-radius:6px;background:var(--bg-elev-2);color:var(--text);font-size:13px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;transition:background 0.15s,color 0.15s;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          手机号
        </button>
        <button type="button"
          data-auth-toggle-target="emailBtn"
          data-action="click->auth-toggle#selectEmail"
          data-active="false"
          style="flex:1;height:32px;border:none;border-radius:6px;background:transparent;color:var(--text-2);font-size:13px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;transition:background 0.15s,color 0.15s;">
          <%= inline_svg_icon("mail") %> 邮箱
        </button>
      </div>

      <%= form_with url: identification_path, method: :post, class: "stack", style: "gap:16px;" do |f| %>
        <div>
          <label class="label" data-auth-toggle-target="label">手机号</label>
          <input
            type="tel"
            name="phone"
            placeholder="138 0000 0000"
            class="input input-lg"
            autofocus
            autocomplete="tel"
            data-auth-toggle-target="input">
        </div>
        <input type="hidden" name="channel" value="sms" data-auth-toggle-target="channelField">

        <% if flash[:alert] %>
          <div style="color:var(--danger);font-size:12px;"><%= flash[:alert] %></div>
        <% end %>

        <button type="submit" class="btn btn-primary btn-lg" style="width:100%;justify-content:center;">
          发送验证码
        </button>

        <div style="font-size:11px;color:var(--text-3);text-align:center;line-height:1.5;">
          继续即表示同意《社区公约》和《隐私协议》。<br>首次登录将自动创建账号。
        </div>
      <% end %>

      <div style="display:flex;align-items:center;gap:10px;color:var(--text-3);font-size:12px;">
        <hr style="flex:1;border:none;border-top:1px solid var(--border);">
        <span>或</span>
        <hr style="flex:1;border:none;border-top:1px solid var(--border);">
      </div>

      <a href="<%= semi_oauth_login_path %>" class="btn btn-lg" style="width:100%;justify-content:center;gap:8px;display:inline-flex;align-items:center;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
        使用 Semi 账号登录
      </a>
    </div>
  </div>
</div>
