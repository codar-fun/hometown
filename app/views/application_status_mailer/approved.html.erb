<h2>恭喜！你的报名已被批准！</h2>
<p>嗨 <%= @user.display_name %>,</p>
<p>好消息 — 你对 <strong><%= @form.title %></strong> 的报名已被批准！</p>

<% if @form.submission_message.present? || @form.submission_image.attached? %>
  <div style="margin: 20px 0; padding: 16px; background-color: #f5f5f5; border-radius: 8px;">
    <% if @form.submission_message.present? %>
      <div style="margin-bottom: 12px;">
        <%= simple_format(@form.submission_message) %>
      </div>
    <% end %>
    <% if @form.submission_image.attached? %>
      <div>
        <%= image_tag attachments[@form.submission_image.filename.to_s].url, alt: "submission image", style: "max-width: 100%; height: auto; border-radius: 4px;" %>
      </div>
    <% end %>
  </div>
<% end %>

<% if @submission.admin_note.present? %>
  <p><strong>组织者留言：</strong> <%= simple_format(@submission.admin_note) %></p>
<% end %>
<p>期待在活动中见到你！</p>
<p>Hometown Team</p>
