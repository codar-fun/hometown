<% content_for :title, "#{@user.display_name} — Hometown" %>
<div class="page" style="max-width:880px;">
  <div class="profile-banner"></div>

  <div style="padding:0 24px;position:relative;">
    <div style="display:flex;align-items:flex-end;gap:20px;margin-bottom:24px;">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, alt: @user.display_name, style: "width:96px;height:96px;border-radius:50%;border:4px solid var(--bg);flex-shrink:0;object-fit:cover;" %>
      <% else %>
        <div class="avatar" style="width:96px;height:96px;font-size:36px;border:4px solid var(--bg);flex-shrink:0;<%= @user.avatar_color.present? ? "background:#{@user.avatar_color};color:#0C0A09;" : "" %>">
          <%= @user.name&.first || @user.email&.first&.upcase || "?" %>
        </div>
      <% end %>
      <div style="flex:1;padding-bottom:8px;">
        <div style="font-size:22px;font-weight:600;letter-spacing:-0.02em;"><%= @user.display_name %></div>
        <div style="font-size:13px;color:var(--text-2);font-family:var(--font-mono);">
          <% if @user.handle.present? %>@<%= @user.handle %> · <% end %>加入于 <%= @user.created_at.strftime("%Y-%m-%d") %>
        </div>
      </div>
      <% if logged_in? && current_user == @user %>
        <%= link_to "编辑资料", edit_profile_path(@user), class: "btn" %>
      <% elsif logged_in? %>
        <button class="btn btn-primary btn-sm">+ 关注</button>
      <% end %>
    </div>
  </div>

  <div style="padding:0 24px;">
    <div class="grid-2-1" style="gap:20px;margin-bottom:0;">
      <div class="stack" style="gap:20px;">
        <% if @user.bio.present? %>
          <div class="card">
            <div style="font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:8px;">简介</div>
            <p style="margin:0;font-size:14px;line-height:1.6;"><%= @user.bio %></p>
          </div>
        <% end %>

        <% if @hackathons.any? %>
          <div class="card">
            <div style="font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:12px;">参加的黑客松</div>
            <div class="stack" style="gap:10px;">
              <% @hackathons.each do |hackathon| %>
                <div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--border);">
                  <div style="flex:1;">
                    <div style="font-size:13px;font-weight:500;margin-bottom:2px;">
                      <%= link_to hackathon.name, hackathon_path(hackathon), style: "color:var(--text);text-decoration:none;" %>
                    </div>
                    <% participant = @user.hackathon_participants.find_by(hackathon_id: hackathon.id) %>
                    <div style="font-size:11px;color:var(--text-3);">
                      <%= participant&.role %> · <%= hackathon.created_at.strftime("%Y 年 %-m 月") %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="card">
          <div style="font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:16px;">我的活动</div>
          <% if @submissions.any? %>
            <div class="stack" style="gap:10px;">
              <% @submissions.each do |sub| %>
                <div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--border);">
                  <div style="flex:1;">
                    <div style="font-size:13px;font-weight:500;margin-bottom:2px;"><%= sub.form.title %></div>
                    <div style="font-size:11px;color:var(--text-3);"><%= sub.submitted_at.strftime("%-m 月 %-d 日") %></div>
                  </div>
                  <%= status_badge(sub.status) %>
                  <%= link_to "查看", form_submission_path(sub), class: "btn btn-ghost btn-sm" %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p style="color:var(--text-3);font-size:13px;margin:0;">还没有参与记录。</p>
          <% end %>
        </div>
      </div>

      <div class="stack" style="gap:20px;">
        <div class="card">
          <div style="font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:12px;">联系方式</div>
          <div class="stack" style="gap:10px;font-size:13px;">
            <% if @user.email.present? %>
              <div style="display:flex;align-items:center;gap:8px;">
                <%= inline_svg_icon("mail") %> <span class="mono"><%= @user.email %></span>
              </div>
            <% end %>
            <% if @user.phone.present? %>
              <div style="display:flex;align-items:center;gap:8px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span class="mono"><%= @user.phone %></span>
              </div>
            <% end %>
            <% if @user.github.present? %>
              <div style="display:flex;align-items:center;gap:8px;">
                <%= inline_svg_icon("github") %> <span class="mono"><%= @user.github %></span>
              </div>
            <% end %>
          </div>
        </div>

        <% skills = Array(@user.skills) %>
        <% if skills.any? %>
          <div class="card">
            <div style="font-size:11px;font-weight:500;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;margin-bottom:12px;">技能</div>
            <div style="display:flex;flex-wrap:wrap;gap:6px;">
              <% skills.each do |s| %>
                <span class="badge"><%= s %></span>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="card" style="padding:16px;">
          <div style="display:flex;justify-content:space-between;text-align:center;">
            <div>
              <div style="font-size:20px;font-weight:600;font-family:var(--font-mono);"><%= @submissions.count %></div>
              <div style="font-size:11px;color:var(--text-3);">报名</div>
            </div>
            <div>
              <div style="font-size:20px;font-weight:600;font-family:var(--font-mono);"><%= @user.project_team_members.count %></div>
              <div style="font-size:11px;color:var(--text-3);">项目</div>
            </div>
            <div>
              <div style="font-size:20px;font-weight:600;font-family:var(--font-mono);"><%= @user.followers.count %></div>
              <div style="font-size:11px;color:var(--text-3);">关注者</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
