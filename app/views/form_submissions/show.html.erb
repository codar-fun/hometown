<% content_for :title, "#{@submission.form.title} — 报名详情" %>
<div style="max-width:640px;margin:0 auto;padding:40px 24px 80px;">

  <%# Header %>
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:32px;">
    <div class="brand-mark">H</div>
    <div style="font-size:13px;color:var(--text-2);">Hometown</div>
  </div>

  <%# Status card %>
  <% status_config = {
    "pending"  => { icon: "⏳", label: "审核中",   bg: "var(--bg-elev)", border: "var(--border)",       text: "我们正在审核你的报名，结果将通过邮件通知。" },
    "approved" => { icon: "🎉", label: "已通过",   bg: "#ECFCCB",        border: "#BBF7D0",              text: "恭喜！你的报名已通过，请查收邮件了解后续安排。" },
    "rejected" => { icon: "💌", label: "未通过",   bg: "var(--bg-elev)", border: "var(--border)",       text: "很遗憾这次未能入选，感谢你的参与，期待下次再见。" },
  } %>
  <% cfg = status_config[@submission.status] || status_config["pending"] %>

  <div style="padding:20px 24px;background:<%= cfg[:bg] %>;border:1px solid <%= cfg[:border] %>;border-radius:12px;margin-bottom:28px;display:flex;align-items:flex-start;gap:14px;">
    <div style="font-size:28px;line-height:1;flex-shrink:0;"><%= cfg[:icon] %></div>
    <div>
      <div style="font-size:16px;font-weight:600;margin-bottom:4px;"><%= cfg[:label] %></div>
      <div style="font-size:13px;color:var(--text-2);line-height:1.5;"><%= cfg[:text] %></div>
      <% if @submission.admin_note.present? %>
        <div style="margin-top:10px;padding:10px 12px;background:rgba(0,0,0,0.05);border-radius:6px;font-size:13px;color:var(--text);">
          <strong>组织者留言：</strong><%= @submission.admin_note %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Submission message (only show when approved) %}
  <% if @submission.status == "approved" && @submission.form.submission_message.present? %>
    <div style="padding:16px 20px;background:#E0F2FE;border:1px solid #BAE6FD;border-radius:8px;margin-bottom:24px;">
      <div style="font-size:14px;color:#0369A1;line-height:1.6;margin-bottom:12px;">
        <%= simple_format(@submission.form.submission_message) %>
      </div>
      <% if @submission.form.submission_image.attached? %>
        <div style="margin-top:12px;">
          <%= image_tag @submission.form.submission_image, style: "max-width:200px;border-radius:8px;" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%# Meta info %>
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
    <div>
      <div style="font-size:18px;font-weight:700;letter-spacing:-0.01em;"><%= @submission.form.title %></div>
      <div style="font-size:12px;color:var(--text-3);margin-top:2px;">
        提交于 <%= @submission.submitted_at.strftime("%-m 月 %-d 日 %H:%M") %>
      </div>
    </div>
    <%= status_badge(@submission.status) %>
  </div>

  <%# Answers %>
  <div class="card" style="padding:0;overflow:hidden;">
    <div style="padding:12px 16px;border-bottom:1px solid var(--border);font-size:11px;font-weight:600;color:var(--text-3);letter-spacing:0.04em;text-transform:uppercase;">
      你的回答
    </div>
    <% @submission.form_answers.includes(:form_field).order("form_fields.position").each do |answer| %>
      <div style="display:grid;grid-template-columns:160px 1fr;padding:14px 16px;border-bottom:1px solid var(--border);gap:12px;align-items:start;">
        <div style="font-size:12px;color:var(--text-3);padding-top:1px;"><%= answer.form_field.label %></div>
        <div style="font-size:14px;line-height:1.6;">
          <% if answer.form_field.field_type == "file" && answer.file_attachment.attached? %>
            <%= link_to answer.file_attachment.filename,
                  rails_blob_path(answer.file_attachment, disposition: "attachment"),
                  style: "color:var(--accent);" %>
          <% elsif answer.value.blank? %>
            <span style="color:var(--text-3);">—</span>
          <% else %>
            <%= answer.value %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div style="margin-top:24px;display:flex;gap:10px;">
    <%= link_to root_path, class: "btn" do %>← 返回首页<% end %>
    <% if logged_in? && current_user %>
      <%= link_to profile_path(current_user), class: "btn" do %>我的主页<% end %>
    <% end %>
    <% if @submission.status == "pending" && @submission.user == current_user %>
      <%= link_to edit_form_submission_path(@submission), class: "btn btn-primary" do %>修改报名<% end %>
    <% end %>
  </div>
</div>
