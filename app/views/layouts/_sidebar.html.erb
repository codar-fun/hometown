<%
  pending_count = defined?(FormSubmission) ? FormSubmission.pending.count : 0
  nav_items = [
    { path: root_path,    label: "首页",     icon: "home",     id: "home" },
    { path: projects_path,label: "项目展示", icon: "grid",     id: "projects" },
    { path: teams_path,   label: "团队",     icon: "users",    id: "teams" },
    { path: members_path, label: "成员广场", icon: "users",    id: "members" },
  ]
%>
<aside class="sidebar" data-sidebar-target="panel">
  <%# Close button visible on mobile only %>
  <div class="sidebar-close-btn" style="justify-content:space-between;align-items:center;margin-bottom:4px;">
    <div class="brand-mark" style="width:24px;height:24px;font-size:12px;border-radius:6px;">H</div>
    <button class="btn btn-ghost btn-sm" data-action="sidebar#close" aria-label="关闭菜单" style="padding:0 8px;">✕</button>
  </div>

  <div class="brand">
    <div class="brand-mark">H</div>
    <div class="brand-name">Hometown</div>
  </div>

  <div class="nav-section-label">社区</div>
  <% nav_items.each do |item| %>
    <%= link_to item[:path],
          class: "nav-item #{request.path == item[:path] ? 'active' : ''}",
          data: { action: "sidebar#closeOnMobile" } do %>
      <%= inline_svg_icon(item[:icon]) %>
      <span><%= item[:label] %></span>
    <% end %>
  <% end %>

  <% if logged_in? %>
    <% hack_form = Form.where(published: true).order(created_at: :desc).first %>
    <% if hack_form %>
      <%= link_to form_path(hack_form.slug),
            class: "nav-item #{request.path.include?('/forms/') ? 'active' : ''}",
            data: { action: "sidebar#closeOnMobile" } do %>
        <%= inline_svg_icon("bolt") %>
        <span>黑客松报名</span>
      <% end %>
    <% end %>

    <% if current_user.form_submissions.any? %>
      <div class="nav-section-label">我的表单</div>
      <% current_user.form_submissions.order(submitted_at: :desc).first(5).each do |sub| %>
        <%= link_to form_submission_path(sub),
              class: "nav-item #{request.path == form_submission_path(sub) ? 'active' : ''}",
              data: { action: "sidebar#closeOnMobile" },
              title: sub.form.title do %>
          <%= inline_svg_icon("clipboard") %>
          <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
            <%= truncate(sub.form.title, length: 16) %>
          </span>
          <%= status_badge(sub.status) %>
        <% end %>
      <% end %>
    <% end %>

    <%= link_to profile_path(current_user),
          class: "nav-item #{request.path.include?('/profiles/') ? 'active' : ''}",
          data: { action: "sidebar#closeOnMobile" } do %>
      <%= inline_svg_icon("user") %>
      <span>个人主页</span>
    <% end %>
  <% end %>

  <% if logged_in? && current_user.admin? %>
    <div class="nav-section-label">管理员</div>
    <%= link_to admin_hackathons_path,
          class: "nav-item #{request.path.start_with?('/admin/hackathons') ? 'active' : ''}",
          data: { action: "sidebar#closeOnMobile" } do %>
      <%= inline_svg_icon("bolt") %>
      <span>黑客松管理</span>
    <% end %>
    <%= link_to admin_forms_path,
          class: "nav-item #{request.path == admin_forms_path ? 'active' : ''}",
          data: { action: "sidebar#closeOnMobile" } do %>
      <%= inline_svg_icon("form") %>
      <span>所有表单</span>
    <% end %>
    <%= link_to admin_form_submissions_path,
          class: "nav-item #{request.path.start_with?('/admin/form_submissions') ? 'active' : ''}",
          data: { action: "sidebar#closeOnMobile" } do %>
      <%= inline_svg_icon("inbox") %>
      <span>报名审核</span>
      <% if pending_count > 0 %>
        <span class="nav-badge"><%= pending_count %></span>
      <% end %>
    <% end %>
    <%= link_to admin_email_preview_path,
          class: "nav-item #{request.path.include?('email_preview') ? 'active' : ''}",
          data: { action: "sidebar#closeOnMobile" } do %>
      <%= inline_svg_icon("mail") %>
      <span>邮件模板</span>
    <% end %>
  <% end %>

  <div class="nav-spacer"></div>

  <% if logged_in? %>
    <div style="display:flex;align-items:center;gap:8px;">
      <%= link_to profile_path(current_user), class: "user-card", style: "flex:1;min-width:0;",
            data: { action: "sidebar#closeOnMobile" } do %>
        <% if current_user.avatar.attached? %>
          <%= image_tag current_user.avatar, class: "avatar", alt: current_user.display_name, style: "object-fit:cover;" %>
        <% else %>
          <div class="avatar" style="<%= current_user.avatar_color.present? ? "background:#{current_user.avatar_color};color:#0C0A09;" : "" %>">
            <%= current_user.name&.first || current_user.email&.first&.upcase || "?" %>
          </div>
        <% end %>
        <div class="user-meta">
          <div class="nm"><%= current_user.display_name %></div>
          <div class="sub"><%= current_user.admin? ? "Admin" : "社区成员" %></div>
        </div>
      <% end %>
      <%= link_to sign_out_path, data: { turbo_method: :delete }, class: "btn btn-ghost btn-sm", title: "退出" do %>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
      <% end %>
    </div>
  <% else %>
    <%= link_to new_identification_path, class: "btn btn-primary", style: "justify-content:center;width:100%;",
          data: { action: "sidebar#closeOnMobile" } do %>
      登录 / 注册
    <% end %>
  <% end %>
</aside>
